{
    "extends": "../../packages/config/typescript/nextjs.json",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        },
        "tsBuildInfoFile": ".next/cache/tsconfig.tsbuildinfo"
    },
    "include": [
        "next-env.d.ts",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts",
        "**/*.ts",
        "**/*.tsx"
    ],
    "exclude": ["node_modules", ".next", "coverage"]
}
