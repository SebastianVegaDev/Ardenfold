{
    "name": "ardenfold",
    "version": "0.0.0",
    "private": true,
    "description": "Privacy-first platform for securely organizing and sharing important personal information.",
    "license": "UNLICENSED",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "test:security": "pnpm exec turbo run build --filter=@ardenfold/api... && pnpm --filter @ardenfold/e2e test:security",
        "format": "prettier --write **/*.{js,mjs,cjs,ts,tsx,json,css,yml,yaml}",
        "format:check": "prettier --check **/*.{js,mjs,cjs,ts,tsx,json,css,yml,yaml}",
        "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
        "db:up": "docker compose up -d postgres",
        "db:down": "docker compose down",
        "db:status": "docker compose ps",
        "db:logs": "docker compose logs --tail=100 -f postgres",
        "db:generate": "pnpm --filter @ardenfold/database db:generate",
        "db:migrate": "pnpm --filter @ardenfold/database db:migrate",
        "db:check": "pnpm --filter @ardenfold/database db:check",
        "db:validate": "pnpm --filter @ardenfold/database db:validate"
    },
    "engines": {
        "node": ">=24.21.0 <25",
        "pnpm": ">=12 <13"
    },
    "packageManager": "pnpm@12.5.1",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@next/eslint-plugin-next": "^16.3.5",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.12.0",
        "prettier": "^3.9.8",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "turbo": "2.11.0",
        "typescript-eslint": "^8.70.0"
    }
}
