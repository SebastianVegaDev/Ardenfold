{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "globalEnv": [
        "ARDENFOLD_API_URL",
        "AUTH_JWT_CLOCK_TOLERANCE_SECONDS",
        "NEXT_PUBLIC_ARDENFOLD_FALLBACK_LOCALE",
        "NEXT_PUBLIC_WORKOS_REDIRECT_URI",
        "WORKOS_API_KEY",
        "WORKOS_CLIENT_ID",
        "WORKOS_COOKIE_PASSWORD",
        "WORKOS_ISSUER",
        "WORKOS_JWKS_URL"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**", "dist/**"]
        },
        "dev": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": ["^build", "^lint"],
            "outputs": []
        },
        "typecheck": {
            "dependsOn": ["^build", "^typecheck"],
            "outputs": []
        },
        "test": {
            "dependsOn": ["^build", "^test"],
            "env": ["CI", "DATABASE_TEST_URL"],
            "outputs": ["coverage/**"]
        }
    }
}
