# Application
NODE_ENV=development
API_PORT=3001
NEXT_PUBLIC_ARDENFOLD_FALLBACK_LOCALE=en

# WorkOS AuthKit
# Only NEXT_PUBLIC_WORKOS_REDIRECT_URI is safe to expose to browser bundles.
WORKOS_CLIENT_ID=client_replace-with-workos-client-id
WORKOS_API_KEY=replace-with-workos-api-key
WORKOS_COOKIE_PASSWORD=replace-with-at-least-32-random-characters
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
WORKOS_ISSUER=https://api.workos.com/
WORKOS_WEBHOOK_SECRET=replace-with-workos-webhook-secret

# PostgreSQL container
POSTGRES_DB=ardenfold
POSTGRES_PORT=5432
POSTGRES_MIGRATION_USER=ardenfold_migrator
POSTGRES_MIGRATION_PASSWORD=replace-with-local-migration-password
POSTGRES_RUNTIME_USER=ardenfold_app
POSTGRES_RUNTIME_PASSWORD=replace-with-local-runtime-password

# Database connections: the API must never receive DATABASE_MIGRATION_URL.
DATABASE_MIGRATION_URL=postgresql://${POSTGRES_MIGRATION_USER}:${POSTGRES_MIGRATION_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL=postgresql://${POSTGRES_RUNTIME_USER}:${POSTGRES_RUNTIME_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
